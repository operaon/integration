NODE_ENV=development
PORT=4720
HOST=0.0.0.0
SERVICE_NAME=operaon_integration
SERVICE_API_KEY=<integration-service-key>

JWT_ALGORITHM=HS256
JWT_SECRET=<integration-jwt-secret>
JWT_ISSUER=operaon-identity
JWT_AUDIENCE=operaon-api,operaon-integration
JWT_ACCESS_EXPIRATION=15m
JWT_PUBLIC_KEY=

DB_NAME=operaon_integration
DB_USER=dbadmin
DB_PASSWORD=<database-password>
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

CORS_ORIGIN=*
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=5000
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_LIMIT=100

# Mantido para o backfill somente-aditivo a partir da API central.
LEGACY_DATABASE_URL=
LEGACY_DB_NAME=velyon_api
LEGACY_DB_USER=dbadmin
LEGACY_DB_PASSWORD=<legacy-database-password>
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=5432
BACKFILL_DRY_RUN=true

# Provider health checks são executados pelo gateway durante o primeiro corte.
HEALTH_CHECK_ENABLED=false
HEALTH_CHECK_TIMEOUT_MS=5000

# ==================== OPERAON COMMUNICATION CONTRACT ====================
# Identidade não secreta do serviço. Segredos reais devem vir do secret manager.
SERVICE_NAME=operaon-integration
COMMUNICATION_PROTOCOL_VERSION=1
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
INTERNAL_REQUEST_TIMEOUT_MS=5000
INTERNAL_RETRY_MAX_ATTEMPTS=3
COMMUNICATION_KEY_ID=service-key-v1
WEBHOOK_KEY_ID=webhook-key-v1
